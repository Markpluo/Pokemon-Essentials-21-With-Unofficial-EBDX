{
  "name": "@hafnia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --packages=external --alias:@hafnia/core=../../packages/core/src/index.ts --alias:@hafnia/pack-hafnia=../../packs/hafnia/src/index.ts --loader:.json=json",
    "invite": "tsx src/cli.ts invite",
    "admin": "tsx src/cli.ts admin"
  },
  "dependencies": {
    "@hafnia/core": "*",
    "@hafnia/pack-hafnia": "*",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
